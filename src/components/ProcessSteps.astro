---
import Icon from './Icon.astro';
import { steps } from '../data/approach.ts';
interface Props {
  detailed?: boolean;
  headingLevel?: 'h3' | 'h4';
  tone?: 'light' | 'dark';
}
const { detailed = false, headingLevel = 'h3', tone = 'light' } = Astro.props;
const H = headingLevel;
---
<div class:list={['process', `process-${tone}`]} data-draw>
  <ol class="steps" id="steps">
    {steps.map((s, i) => (
      <li class="step" style={`--i: ${i}`}>
        <div class="marker" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span></div>
        <span class="connector" aria-hidden="true"></span>
        <div class="step-body">
          <H class="step-name">{s.name}</H>
          <p class="step-summary">{s.summary}</p>
          {detailed && <p class="step-detail">{s.detail}</p>}
          <a class="step-link" href={s.service.href}>{s.service.label.split(' ').slice(0, -1).join(' ')} <span class="nowrap">{s.service.label.split(' ').at(-1)}<Icon name="arrow" size={15} class="step-arrow" /></span></a>
        </div>
      </li>
    ))}
  </ol>
  <p class="loop-note"><span class="loop-icon" aria-hidden="true">↺</span> Verification results become the baseline for the next round of assessment.</p>
</div>

<style>
  /* Columns separated by 1px dividers, with a top rule drawn by the existing .connector elements. */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .step { position: relative; padding: 1.75rem 0 2rem; }
  .connector {
    position: absolute; left: 0; right: 0; top: 0;
    height: 1px; background: var(--line);
    transform-origin: left;
  }
  .marker {
    display: block;
    font-family: var(--font-sans); font-size: 4.5rem; font-weight: 600; letter-spacing: -0.05em; line-height: 1;
    color: var(--teal);
    margin-bottom: 1.25rem;
  }
  .step:last-child .marker { color: var(--flare-dark); }
  .step-name { font-size: 1.375rem; letter-spacing: -0.02em; margin: 0 0 0.5rem; }
  .step-summary { margin: 0 0 0.5rem; color: var(--ink-muted); }
  .step-detail { margin: 0 0 0.6rem; color: var(--ink-muted); font-size: 0.95rem; }
  .step-link { display: inline-block; padding-block: 0.75rem; font-size: 0.925rem; font-weight: 600; text-decoration: none; line-height: 1.4; }
  .step-link:hover { text-decoration: underline; }
  .nowrap { white-space: nowrap; }
  .step-link :global(.step-arrow) { display: inline-block; vertical-align: -0.15em; margin-left: 0.3rem; transition: transform 180ms ease; }
  .step-link:hover :global(.step-arrow) { transform: translateX(3px); }
  .loop-note {
    display: flex; gap: 0.75rem; align-items: center; margin: 1.5rem 0 0; max-width: none;
    padding: 1rem 1.5rem; border-radius: var(--radius-card);
    background: var(--wash); color: var(--ink-muted); font-size: 0.975rem;
  }
  .loop-icon { font-size: 1.25rem; color: var(--flare); }

  @media (min-width: 60rem) {
    .steps { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .step { padding: 2rem 1.5rem 0.5rem; }
    .step:first-child { padding-left: 0; }
    .step + .step { border-left: 1px solid var(--line); }
    .loop-note { margin-top: 2.5rem; }
  }

  /* Dark variant */
  .process-dark .connector { background: var(--teal-line); }
  .process-dark .step + .step { border-left-color: var(--teal-line); }
  .process-dark .marker { color: var(--lagoon); }
  .process-dark .step:last-child .marker { color: var(--flare-light); }
  .process-dark .step-name { color: var(--white); }
  .process-dark .step-summary { color: var(--mist); }
  .process-dark .step-detail { color: var(--mist-3); }
  .process-dark .step-link { color: var(--lagoon); }
  .process-dark .step-link:hover { color: var(--white); }
  .process-dark .loop-note { background: var(--teal-panel); border: 1px solid var(--teal-line); color: var(--mist); }
  .process-dark .loop-icon { color: var(--flare-light); }

  /* Entrance: each connector draws, then the next stage appears. Only when motion is allowed and the
     motion script is running; otherwise everything is static and visible. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-ready) .process:not(:global(.done)) .connector {
      transition: transform 420ms var(--ease-out);
      transition-delay: calc(var(--i) * 130ms + 120ms);
    }
    :global(.motion-ready) .process:not(:global(.done)) :is(.marker, .step-body) {
      transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out);
      transition-delay: calc(var(--i) * 130ms);
    }
    :global(.motion) .process:not(:global(.is-in)) .connector { transform: scaleY(0); }
    :global(.motion) .process:not(:global(.is-in)) :is(.marker, .step-body) { opacity: 0; transform: translateY(10px); }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 60rem) {
    :global(.motion) .process:not(:global(.is-in)) .connector { transform: scaleX(0); }
  }
</style>
