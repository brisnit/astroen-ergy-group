---
import Icon from './Icon.astro';
import { steps } from '../data/approach.ts';
interface Props {
  detailed?: boolean;
  headingLevel?: 'h3' | 'h4';
  tone?: 'light' | 'dark';
}
const { detailed = false, headingLevel = 'h3', tone = 'light' } = Astro.props;
const H = headingLevel;
---
<div class:list={['process', `process-${tone}`]} data-draw>
  <ol class="steps" id="steps">
    {steps.map((s, i) => (
      <li class="step" style={`--i: ${i}`}>
        <div class="marker" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span></div>
        <span class="connector" aria-hidden="true"></span>
        <div class="step-body">
          <H class="step-name">{s.name}</H>
          <p class="step-summary">{s.summary}</p>
          {detailed && <p class="step-detail">{s.detail}</p>}
          <a class="step-link" href={s.service.href}>{s.service.label.split(' ').slice(0, -1).join(' ')} <span class="nowrap">{s.service.label.split(' ').at(-1)}<Icon name="arrow" size={15} class="step-arrow" /></span></a>
        </div>
      </li>
    ))}
  </ol>
  <p class="loop-note"><span class="loop-icon" aria-hidden="true">↺</span> Verification results become the baseline for the next round of assessment.</p>
</div>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .step { position: relative; padding: 0 0 1.9rem 3.6rem; }
  .connector {
    position: absolute; left: 1.2rem; top: 2.6rem; bottom: 0.3rem;
    width: 2px; background: var(--accent);
    transform-origin: top;
  }
  .step:last-child .connector { display: none; }
  .marker {
    position: absolute; left: 0; top: 0; z-index: 1;
    width: 2.5rem; height: 2.5rem; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--white); border: 2px solid var(--accent);
    font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-strong);
  }
  .step-name { font-size: 1.3rem; margin: 0.35rem 0 0.35rem; }
  .step-summary { margin: 0 0 0.4rem; color: var(--ink); }
  .step-detail { margin: 0 0 0.5rem; color: var(--ink-2); font-size: 0.95rem; }
  .step-link { display: inline-block; padding-block: 0.3rem; font-size: 0.925rem; font-weight: 620; text-decoration: none; line-height: 1.4; }
  .step-link:hover { text-decoration: underline; }
  .nowrap { white-space: nowrap; }
  .step-link :global(.step-arrow) { display: inline-block; vertical-align: -0.15em; margin-left: 0.3rem; transition: transform 180ms ease; }
  .step-link:hover :global(.step-arrow) { transform: translateX(3px); }
  .loop-note { display: flex; gap: 0.6rem; align-items: center; margin: 0.5rem 0 0; color: var(--ink-2); font-size: 0.95rem; max-width: none; }
  .loop-icon { font-size: 1.2rem; color: var(--accent); }

  @media (min-width: 60rem) {
    .steps { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.5rem; }
    .step { padding: 3.75rem 0 0; }
    .connector { left: 2.9rem; right: -1.1rem; top: 1.2rem; bottom: auto; width: auto; height: 2px; transform-origin: left; }
    .loop-note { margin-top: 1.75rem; }
  }

  /* Dark variant */
  .process-dark .connector { background: var(--on-dark-accent); }
  .process-dark .marker { background: var(--dark); border-color: var(--on-dark-accent); color: var(--on-dark-accent); }
  .process-dark .step-summary { color: var(--on-dark); }
  .process-dark :is(.step-detail, .loop-note) { color: var(--on-dark-muted); }
  .process-dark .loop-icon { color: var(--on-dark-accent); }
  .process-dark .step-link { color: var(--on-dark-accent); }
  .process-dark .step-link:hover { color: #fff; }

  /* Entrance: each connector draws, then the next stage appears. Only when motion is allowed and the
     motion script is running; otherwise everything is static and visible. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion-ready) .process:not(:global(.done)) .connector {
      transition: transform 420ms var(--ease-out);
      transition-delay: calc(var(--i) * 130ms + 120ms);
    }
    :global(.motion-ready) .process:not(:global(.done)) :is(.marker, .step-body) {
      transition: opacity 420ms var(--ease-out), transform 420ms var(--ease-out);
      transition-delay: calc(var(--i) * 130ms);
    }
    :global(.motion) .process:not(:global(.is-in)) .connector { transform: scaleY(0); }
    :global(.motion) .process:not(:global(.is-in)) :is(.marker, .step-body) { opacity: 0; transform: translateY(10px); }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 60rem) {
    :global(.motion) .process:not(:global(.is-in)) .connector { transform: scaleX(0); }
  }
</style>
