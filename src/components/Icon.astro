---
/** Small inline icon set. Decorative by default (aria-hidden). */
interface Props {
  name: 'arrow' | 'search' | 'menu' | 'close' | 'chevron' | 'phone' | 'external' | 'sparkle' | 'pin';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  arrow: '<path d="M4 10h11M11 5.5 15.5 10 11 14.5"/>',
  search: '<circle cx="8.75" cy="8.75" r="5.25"/><path d="m12.75 12.75 4 4"/>',
  menu: '<path d="M3 6h14M3 10h14M3 14h14"/>',
  close: '<path d="m5 5 10 10M15 5 5 15"/>',
  chevron: '<path d="m5.5 8 4.5 4.5L14.5 8"/>',
  phone: '<path d="M6.5 3h-2A1.5 1.5 0 0 0 3 4.6C3.3 11 9 16.7 15.4 17a1.5 1.5 0 0 0 1.6-1.5v-2l-3.4-1.4-1.6 1.6a9 9 0 0 1-4.7-4.7l1.6-1.6z"/>',
  external: '<path d="M8 4H4v12h12v-4M11 3h6v6M17 3l-8 8"/>',
  sparkle: '<path d="M10 2.5v4M10 13.5v4M2.5 10h4M13.5 10h4M5 5l2 2M13 13l2 2M15 5l-2 2M7 13l-2 2"/>',
  pin: '<path d="M10 17.5s5.5-5 5.5-9.5a5.5 5.5 0 0 0-11 0c0 4.5 5.5 9.5 5.5 9.5z"/><circle cx="10" cy="8" r="2"/>',
};
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 20 20"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
