---
export interface Crumb { label: string; href: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="crumbs">
  <ol>
    <li><a href="/">Home</a></li>
    {items.map((c, i) => (
      <li>
        {i === items.length - 1 ? <span aria-current="page">{c.label}</span> : <a href={c.href}>{c.label}</a>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0 0 1rem; padding: 0; font-size: 0.9rem; }
  .crumbs li { display: inline-flex; align-items: center; gap: 0.25rem; color: var(--ink-2); }
  .crumbs li + li::before { content: '/'; color: var(--line-strong); padding-right: 0.25rem; }
  .crumbs a, .crumbs [aria-current] { display: inline-flex; align-items: center; min-height: 2.75rem; }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--accent-strong); text-decoration: underline; }
</style>
