---
import Logo from './Logo.astro';
import { solutionLinks, industryLinks } from '../data/nav.ts';
import { company } from '../data/company.ts';
const year = new Date().getFullYear();
---
<footer class="site-footer section-night">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <Logo tone="light" />
      <p class="muted">Building assessment, energy modeling, design/build, monitoring and verification, and funding support.</p>
      <address>
        {company.address.street}<br />
        {company.address.city}, {company.address.region} {company.address.postalCode}<br />
        <a href={company.phoneHref}>{company.phone}</a>
      </address>
    </div>
    <nav aria-label="Solutions" class="footer-col">
      <h2>Solutions</h2>
      <ul>{solutionLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Industries" class="footer-col">
      <h2>Industries</h2>
      <ul>{industryLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="Company" class="footer-col">
      <h2>Company</h2>
      <ul>
        <li><a href="/approach/">Our approach</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/search/">Ask Astro search</a></li>
        <li><a href="/contact/">Discuss your building</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap footer-base">
    <p>© {year} {company.name}. All rights reserved.</p>
    <p>Ask Astro answers are generated from this website’s content only. They are general information, not engineering, legal or financial advice.</p>
    <p>Photography: Unsplash and Pexels contributors; images are illustrative and do not depict Astro projects.</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: var(--space-xl) var(--space-l); margin-top: 0; }
  .footer-grid { display: grid; gap: var(--space-l); grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
  .footer-brand { grid-column: 1 / -1; max-width: 26rem; }
  @media (min-width: 64rem) {
    .footer-grid { grid-template-columns: 1.6fr 1fr 1fr 1fr; }
    .footer-brand { grid-column: auto; }
  }
  .footer-brand p { margin-top: 1.25rem; }
  address { font-style: normal; color: var(--night-muted); line-height: 1.7; }
  .footer-col h2 { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--night-muted); margin-bottom: 1rem; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.15rem; }
  .footer-col a { display: inline-flex; min-height: 2.25rem; align-items: center; color: var(--night-ink); text-decoration: none; }
  .footer-col a:hover { color: #fff; text-decoration: underline; }
  .footer-base { margin-top: var(--space-l); padding-top: var(--space-m); border-top: 1px solid #22344d; display: grid; gap: 0.25rem; }
  .footer-base p { margin: 0; font-size: 0.85rem; color: var(--night-muted); max-width: none; }
</style>
