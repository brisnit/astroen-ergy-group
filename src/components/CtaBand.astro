---
import Icon from './Icon.astro';
import { company } from '../data/company.ts';
interface Props {
  title?: string;
  text?: string;
  /** Query string carried into the contact form, e.g. "topic=energy-audits". */
  query?: string;
}
const {
  title = 'Talk through your building with us',
  text = 'Tell us what you want to improve. We’ll discuss your goals and constraints and suggest a sensible first step. No obligation.',
  query,
} = Astro.props;
const href = query ? `/contact/?${query}` : '/contact/';
---
<section class="cta-band section-teal" aria-labelledby="cta-title">
  <div class="wrap cta-inner" data-reveal>
    <div>
      <p class="eyebrow">Next step</p>
      <h2 id="cta-title">{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn-primary" href={href}>Discuss your building <Icon name="arrow" /></a>
      <a class="btn btn-secondary" href={company.phoneHref}><Icon name="phone" /> {company.phone}</a>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem); }
  .cta-inner { display: grid; gap: var(--space-m); align-items: end; }
  @media (min-width: 56rem) { .cta-inner { grid-template-columns: 1.5fr 1fr; } .cta-inner .btn-row { justify-content: flex-end; } }
  h2 { max-width: 20ch; color: #fff; }
  .lede { margin-bottom: 0; }
</style>
