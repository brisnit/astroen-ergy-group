---
import BaseLayout from '../layouts/BaseLayout.astro';
import AskForm from '../components/AskForm.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import MvDiagram from '../components/MvDiagram.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import LifestyleImage from '../components/LifestyleImage.astro';
import { home, goals, askPrompts } from '../data/home.ts';
import { faqs } from '../data/company.ts';
import { monitoring, funding } from '../data/solutions.ts';
import { solutionLinks } from '../data/nav.ts';
import { industrySummaries } from '../data/industries.ts';
import type { SlotName } from '../data/images.ts';

const stages = monitoring.sections.find((s) => s.id === 'stages')!;
const fundingWork = funding.sections.find((s) => s.id === 'work')!;
const fundingExpect = funding.sections.find((s) => s.id === 'expectations')!;
const whoWeHelp = home.sections[0];

// Image-led pathways for the three sectors with imagery; the other two follow as compact links.
const featured: { id: string; slot: SlotName }[] = [
  { id: 'healthcare', slot: 'healthcare-life' },
  { id: 'education', slot: 'education-life' },
  { id: 'commercial', slot: 'commercial-life' },
];
const featuredIndustries = featured.map((f) => ({ ...industrySummaries.find((i) => i.id === f.id)!, slot: f.slot }));
const otherIndustries = industrySummaries.filter((i) => !featured.some((f) => f.id === i.id));
const hrefFor = (i: (typeof industrySummaries)[number]) => i.href ?? `/industries/#${i.anchor}`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer.join(' ') },
  })),
};
---
<BaseLayout title={home.metaTitle} description={home.description} schema={[faqSchema]}>
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Energy &amp; infrastructure for existing buildings</p>
        <h1 id="hero-title"><span class="nowrap-md">Better-performing</span> buildings. <span class="h1-accent">A clearer path forward.</span></h1>
        <p class="lede">{home.lede}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact/">Discuss your building <Icon name="arrow" /></a>
          <a class="btn btn-secondary" href="/solutions/">Explore solutions</a>
        </div>

        <div class="ask-panel">
          <AskForm id="home-q" variant="hero" />
          <div class="prompts">
            <p class="prompts-label" id="prompts-label">Try</p>
            <ul aria-labelledby="prompts-label">
              {askPrompts.map((p) => <li><a href={`/search/?q=${encodeURIComponent(p.q)}`} title={p.q}>{p.label}</a></li>)}
            </ul>
          </div>
        </div>
      </div>
      <div class="hero-media">
        <LifestyleImage name="home-hero" eager sizes="(min-width: 64rem) 52vw, 100vw" widths={[640, 960, 1280, 1600, 2000]} class="hero-photo" />
      </div>
    </div>
  </section>

  <!-- 2. Audience -->
  <section class="audience section-peach" aria-labelledby="who-title" id="who-we-help">
    <div class="wrap audience-inner" data-reveal>
      <h2 id="who-title" class="audience-label">{whoWeHelp.heading}</h2>
      <p class="audience-text">{whoWeHelp.body?.[0]}</p>
    </div>
  </section>

  <!-- 3. Goals -->
  <section class="section goals" aria-labelledby="goals-title">
    <div class="wrap goals-grid">
      <div class="goals-head" data-reveal>
        <p class="eyebrow">Start with your goal</p>
        <h2 id="goals-title">What are you trying to improve?</h2>
        <p class="muted">Pick the closest match, or <a href="/contact/">talk it through with us</a>.</p>
      </div>
      <ul class="goal-list" data-stagger>
        {goals.map((g, i) => (
          <li class="goal">
            <span class="goal-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3><a href={g.href}>{g.title}</a></h3>
              <p>{g.text}</p>
            </div>
            <span class="goal-cta" aria-hidden="true">{g.cta} <Icon name="arrow" size={16} class="arrow" /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. One coordinated path -->
  <section class="section section-dark path" aria-labelledby="path-title">
    <div class="wrap">
      <div class="path-head" data-reveal>
        <div>
          <p class="eyebrow">One coordinated path</p>
          <h2 id="path-title">From first assessment to verified results</h2>
        </div>
        <p class="lede">Five stages, one team. You approve each stage before the next begins, and every stage connects to a service you can start with on its own.</p>
      </div>
      <ProcessSteps tone="dark" />
      <p class="path-more" data-reveal><a class="link-arrow" href="/approach/">See the full approach <Icon name="arrow" size={16} /></a></p>
    </div>
  </section>

  <!-- 5. Solutions -->
  <section class="section solutions" aria-labelledby="solutions-title">
    <div class="wrap sol-grid">
      <div class="sol-media" data-reveal>
        <LifestyleImage name="field-assessment" sizes="(min-width: 64rem) 46vw, 100vw" class="sol-photo" caption="Assessments start on site, with the systems themselves." />
      </div>
      <div class="sol-copy">
        <div data-reveal>
          <p class="eyebrow">Solutions</p>
          <h2 id="solutions-title">Five services that work alone, and better together</h2>
          <p class="muted">Start wherever you are. Each one hands off cleanly to the next.</p>
        </div>
        <ul class="sol-list" data-stagger>
          {solutionLinks.map((s) => (
            <li>
              <a href={s.href}>
                <span class="sol-name">{s.label}</span>
                <span class="sol-desc">{s.description}</span>
                <Icon name="arrow" size={18} class="arrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. Industry pathways -->
  <section class="section section-pale-top industries" aria-labelledby="ind-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Industries</p>
        <h2 id="ind-title">Guidance for your type of facility</h2>
      </div>
      <ul class="ind-feature" data-stagger>
        {featuredIndustries.map((i, n) => (
          <li class:list={['ind-card', { 'ind-card-lead': n === 0 }]}>
            <a href={hrefFor(i)} class="ind-link card-link">
              <LifestyleImage name={i.slot} sizes={n === 0 ? '(min-width: 64rem) 56vw, 100vw' : '(min-width: 64rem) 34vw, 100vw'} widths={[480, 800, 1200]} class="ind-photo" hover />
              <span class="ind-text">
                <span class="ind-name">{i.name} <Icon name="arrow" size={18} class="arrow" /></span>
                <span class="ind-concern">{i.concerns.slice(0, 2).join(' · ')}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <ul class="ind-more" data-stagger>
        {otherIndustries.map((i) => (
          <li>
            <a href={hrefFor(i)} class="card-link">
              <span class="ind-name">{i.name}</span>
              <span class="ind-concern">{i.concerns[0]}</span>
              <Icon name="arrow" size={18} class="arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Lifestyle band: shown on the homepage only once the final image exists (its fallback would repeat a photo above). -->
  <LifestyleImage name="building-life" allowFallback={false} sizes="100vw" widths={[800, 1200, 1600, 2000, 2400]} class="band" />

  <!-- 7. Monitoring & verification -->
  <section class="section section-dark mv" aria-labelledby="mv-title-h">
    <div class="wrap split split-even mv-grid">
      <div data-reveal>
        <p class="eyebrow">Monitoring &amp; verification</p>
        <h2 id="mv-title-h">Know whether improvements are working</h2>
        <p class="lede">Measurement and verification (M&amp;V) compares energy use after a project with the baseline measured before it. Astro’s Eco-1 monitoring and analytics system supports each stage.</p>
        <ul class="check-list">{stages.list?.map((l) => <li>{l}</li>)}</ul>
        <p class="mv-link"><a class="link-arrow" href={monitoring.url}>What Eco-1 monitors <Icon name="arrow" size={16} /></a></p>
      </div>
      <MvDiagram />
    </div>
  </section>

  <!-- 8. Funding -->
  <section class="section funding" aria-labelledby="funding-title">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">Funding &amp; incentives</p>
        <h2 id="funding-title">Help paying for improvements, without overpromising</h2>
        <p class="muted">{funding.lede}</p>
        <a class="btn btn-secondary" href={funding.url}>Funding &amp; incentive support <Icon name="arrow" /></a>
      </div>
      <div class="stack">
        <ul class="check-list" data-stagger>{fundingWork.list?.slice(0, 4).map((l) => <li>{l}</li>)}</ul>
        <div class="note note-warm" data-reveal>
          <h3 class="note-title">{fundingExpect.heading}</h3>
          {fundingExpect.body?.map((b) => <p>{b}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 9. FAQs -->
  <section class="section faq" aria-labelledby="faq-title" id="faq">
    <div class="wrap split faq-grid rule-top">
      <div data-reveal>
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">Common questions</h2>
        <p class="muted">Have a different question? <a href="/search/">Ask Astro</a> searches everything on this site.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <!-- 10. Closing CTA (teal) and footer (dark) -->
  <CtaBand />
</BaseLayout>

<style>
  /* 1. Hero: teal-deep, two columns that wrap on mobile. */
  .hero { background: var(--teal-deep); color: var(--mist); padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--section-y); overflow: clip; }
  .hero-grid { display: grid; gap: var(--space-l); align-items: start; }
  .hero-media :global(.hero-photo) { aspect-ratio: 16 / 10; border-radius: 24px; }
  @media (min-width: 64rem) {
    .hero-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr); gap: clamp(2.5rem, 4vw, 4.5rem); }
    .hero-media { margin-top: 0.5rem; }
    .hero-media :global(.hero-photo) { aspect-ratio: 1 / 1.08; max-height: 50rem; }
  }
  .hero .eyebrow { color: var(--lagoon); }
  .hero h1 { color: var(--white); max-width: 15ch; }
  /* At the full 88px size, let 'Better-performing' break rather than overflow its column. */
  .hero :global(.nowrap-md) { white-space: normal; }
  .h1-accent { color: var(--flare-light); }
  .hero .lede { margin-top: 1.4rem; max-width: 36rem; color: var(--mist); }
  .hero .btn-row { margin-top: 1.9rem; }
  .hero .btn-primary { background: var(--flare-light); color: var(--teal-deep); }
  .hero .btn-primary:hover { background: var(--flare-light-hover); color: var(--teal-deep); }
  .hero .btn-secondary { background: transparent; color: var(--mist-2); border-color: var(--teal-border-dark); }
  .hero .btn-secondary:hover { border-color: var(--lagoon); color: var(--white); }
  .hero :focus-visible { box-shadow: 0 0 0 2px var(--teal-deep), 0 0 0 4.5px var(--lagoon); }

  /* Ask Astro: a stardust card with a white input, teal Ask button and white pill prompts. */
  .ask-panel {
    margin-top: 2.5rem; max-width: 38rem;
    padding: 1.35rem 1.35rem 1.2rem;
    background: var(--stardust); color: var(--teal-deep);
    border-radius: var(--radius-card);
  }
  .ask-panel :focus-visible { box-shadow: var(--focus); }
  .ask-panel :global(.ask-field) { box-shadow: none; background: var(--surface); }
  .ask-panel :global(.ask-sub), .ask-panel :global(.ask-hint) { color: var(--ink-muted); }
  .ask-panel :global(.btn-primary) { background: var(--teal); color: var(--white); }
  .ask-panel :global(.btn-primary:hover) { background: var(--teal-deep); color: var(--white); }
  .prompts { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin-top: 1rem; }
  .prompts-label { margin: 0; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: var(--mono-tracking); text-transform: uppercase; color: var(--ink-muted); }
  .prompts ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .prompts a {
    display: inline-flex; align-items: center; min-height: 2.75rem;
    padding: 0.35rem 0.95rem; border-radius: var(--radius-pill);
    background: var(--surface); border: 1px solid var(--line);
    color: var(--teal-deep); text-decoration: none; font-size: 0.85rem; font-weight: 500;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  .prompts a:hover { background: var(--teal-deep); border-color: var(--teal-deep); color: var(--white); }

  /* 2. Audience: surface strip with a bottom border. */
  .audience { padding-block: clamp(1.75rem, 1.25rem + 1.5vw, 2.75rem); background: var(--surface); border-bottom: 1px solid var(--line); }
  .audience-inner { display: grid; gap: 0.5rem 2.5rem; align-items: baseline; }
  @media (min-width: 56rem) { .audience-inner { grid-template-columns: 11rem minmax(0, 1fr); } }
  .audience-label { margin: 0; font-family: var(--font-mono); font-size: var(--mono-size); font-weight: 500; letter-spacing: var(--mono-tracking); text-transform: uppercase; color: var(--teal); }
  .audience-text { margin: 0; font-size: clamp(1.1rem, 1rem + 0.5vw, 1.4rem); line-height: 1.5; max-width: 58rem; letter-spacing: -0.015em; color: var(--teal-deep); }

  /* 3. Goals: big white rows; hover/active turns teal-deep with white text. */
  .goals-grid { display: grid; gap: var(--space-l); }
  @media (min-width: 60rem) {
    .goals-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(2.5rem, 5vw, 5rem); }
    .goals-head { position: sticky; top: calc(var(--header-h) + 2rem); align-self: start; }
  }
  .goal-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  .goal {
    position: relative;
    display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.25rem 1rem;
    padding: 22px 24px; border-radius: 18px;
    background: var(--surface); border: 1px solid var(--line);
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  .goal:is(:hover, :focus-within, :active) { background: var(--teal-deep); border-color: var(--teal-deep); }
  .goal-num { font-family: var(--font-mono); font-size: var(--mono-size); letter-spacing: 0.08em; color: var(--teal); padding-top: 0.35rem; transition: color 200ms ease; }
  .goal h3 { margin: 0 0 0.25rem; font-size: 1.1875rem; font-weight: 600; letter-spacing: -0.02em; }
  .goal h3 a { color: var(--teal-deep); text-decoration: none; transition: color 200ms ease; }
  .goal h3 a::after { content: ''; position: absolute; inset: 0; border-radius: 18px; }
  .goal h3 a:focus-visible { box-shadow: none; }
  .goal:has(a:focus-visible) { box-shadow: 0 0 0 2px var(--stardust), 0 0 0 4.5px var(--teal); }
  .goal p { margin: 0; color: var(--ink-muted); transition: color 200ms ease; }
  .goal-cta { grid-column: 2; display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.4rem; font-size: 0.925rem; font-weight: 600; color: var(--teal); transition: color 200ms ease; }
  .goal-cta :global(.arrow) { transition: transform 180ms ease; }
  .goal:is(:hover, :focus-within, :active) :is(h3 a) { color: var(--white); }
  .goal:is(:hover, :focus-within, :active) p { color: var(--mist); }
  .goal:is(:hover, :focus-within, :active) .goal-num { color: var(--lagoon); }
  .goal:is(:hover, :focus-within, :active) .goal-cta { color: var(--flare-light); }
  .goal:hover .goal-cta :global(.arrow) { transform: translateX(4px); }
  @media (min-width: 48rem) {
    .goal { grid-template-columns: 2.75rem minmax(0, 1fr) 10rem; align-items: center; }
    .goal-cta { grid-column: 3; margin: 0; justify-content: flex-end; }
  }

  /* 4. Path */
  .path-head { display: grid; gap: 1rem 3rem; margin-bottom: var(--space-l); align-items: end; }
  @media (min-width: 56rem) { .path-head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
  .path-head h2 { margin: 0; color: var(--white); }
  .path-head .lede { margin: 0; color: var(--mist); }
  .path-more { margin: var(--space-m) 0 0; }

  /* 5. Services: white cards on wash, mono numbers in teal. */
  .solutions { background: var(--wash); }
  .sol-grid { display: grid; gap: var(--space-l); align-items: center; }
  @media (min-width: 64rem) { .sol-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2.5rem, 5vw, 5rem); } }
  .sol-media :global(.sol-photo) { aspect-ratio: 4 / 3; }
  @media (min-width: 64rem) { .sol-media :global(.sol-photo) { aspect-ratio: 4 / 4.4; } }
  .sol-list { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 0.75rem; counter-reset: sol; }
  .sol-list li { counter-increment: sol; }
  .sol-list a {
    position: relative; display: grid; gap: 0.2rem; padding: 1.15rem 3.25rem 1.15rem 4.25rem;
    background: var(--surface); border-radius: var(--radius-card);
    color: var(--teal-deep); text-decoration: none;
    transition: transform 220ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .sol-list a::before {
    content: counter(sol, decimal-leading-zero);
    position: absolute; left: 1.5rem; top: 1.35rem;
    font-family: var(--font-mono); font-size: var(--mono-size); letter-spacing: 0.08em; color: var(--teal);
  }
  .sol-list a:hover { transform: translateY(-4px); box-shadow: var(--shadow-teal); }
  .sol-name { font-weight: 600; font-size: 1.15rem; letter-spacing: -0.02em; transition: color 180ms ease; }
  .sol-desc { color: var(--ink-muted); font-size: 0.95rem; }
  .sol-list a :global(.arrow) { position: absolute; right: 1.35rem; top: 50%; translate: 0 -50%; color: var(--teal); transition: transform 180ms ease; }
  .sol-list a:hover .sol-name { color: var(--teal); }
  .sol-list a:hover :global(.arrow) { transform: translateX(4px); }

  /* 6. Industries: white cards, mono label on top, pain point at the bottom; Federal in solid teal. */
  .ind-feature { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) {
    .ind-feature { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ind-card-lead { grid-column: 1 / -1; }
  }
  @media (min-width: 64rem) {
    .ind-feature { grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); grid-template-rows: auto auto; }
    .ind-card-lead { grid-column: 1; grid-row: 1 / span 2; }
  }
  .ind-link {
    display: grid; grid-template-rows: auto 1fr; height: 100%;
    background: var(--surface); border: 1px solid var(--line); border-radius: 22px; overflow: hidden;
    color: var(--teal-deep); text-decoration: none;
  }
  .ind-link :global(.ind-photo) { border-radius: 0; aspect-ratio: 16 / 9; }
  .ind-card-lead .ind-link :global(.ind-photo) { aspect-ratio: 4 / 3; }
  @media (min-width: 64rem) { .ind-card-lead .ind-link :global(.ind-photo) { aspect-ratio: auto; height: 100%; min-height: 24rem; } .ind-card-lead .ind-link { grid-template-rows: 1fr auto; } }
  .ind-text { display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; padding: 1.4rem 1.5rem 1.6rem; }
  .ind-name {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: var(--mono-size); font-weight: 500; letter-spacing: var(--mono-tracking); text-transform: uppercase; color: var(--teal);
  }
  .ind-name :global(.arrow) { color: var(--teal); }
  .ind-concern { font-size: 1.375rem; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; color: var(--teal-deep); }
  .ind-more { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 48rem) { .ind-more { grid-template-columns: 1fr 1fr; } }
  .ind-more a {
    position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem;
    min-height: 16.25rem; padding: 1.5rem 1.6rem 1.75rem;
    border: 1px solid var(--line); border-radius: 22px; background: var(--surface);
    color: var(--teal-deep); text-decoration: none;
  }
  .ind-more .ind-concern { padding-right: 2rem; }
  .ind-more a :global(.arrow) { position: absolute; right: 1.5rem; bottom: 1.85rem; color: var(--teal); }
  /* Federal/public card: solid teal for rhythm. */
  .ind-more a[href$='#federal'] { background: var(--teal); border-color: var(--teal); }
  .ind-more a[href$='#federal'] .ind-name,
  .ind-more a[href$='#federal'] .ind-concern { color: var(--white); }
  .ind-more a[href$='#federal'] :global(.arrow) { color: var(--white); }
  .ind-more a[href$='#federal']:hover { border-color: var(--teal-deep); }

  /* Band */
  :global(.band) { border-radius: 0; aspect-ratio: 16 / 9; max-height: 38rem; width: 100%; }
  @media (max-width: 40rem) { :global(.band) { aspect-ratio: 4 / 3; } }

  /* 7. M&V: before/during/after as numbered white cards. */
  .mv-grid { align-items: center; }
  .mv h2 { color: var(--white); }
  .mv .check-list { margin-top: 1.75rem; gap: 0.75rem; counter-reset: stage; }
  .mv .check-list li {
    counter-increment: stage;
    padding: 1.1rem 1.25rem 1.1rem 3.75rem; max-width: none;
    background: var(--surface); color: var(--teal-deep); border-radius: var(--radius-card);
  }
  .mv .check-list li::before {
    content: counter(stage, decimal-leading-zero);
    left: 1.25rem; top: 1.3rem; width: auto; height: auto; background: none;
    font-family: var(--font-mono); font-size: var(--mono-size); letter-spacing: 0.08em; color: var(--teal);
  }
  .mv-link { margin-top: 1.5rem; }

  /* 8. Funding: wash section, heading left, numbered white cards right. */
  .funding { background: var(--wash); }
