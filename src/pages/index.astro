---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AskForm from '../components/AskForm.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import MvDiagram from '../components/MvDiagram.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { home, goals, askSuggestions } from '../data/home.ts';
import { faqs } from '../data/company.ts';
import { solutionPages, monitoring, funding } from '../data/solutions.ts';
import { industrySummaries } from '../data/industries.ts';
import heroPhoto from '../assets/photos/hero-plant.jpg';
import techPhoto from '../assets/photos/technician.jpg';

const stages = monitoring.sections.find((s) => s.id === 'stages')!;
const fundingWork = funding.sections.find((s) => s.id === 'work')!;
const fundingExpect = funding.sections.find((s) => s.id === 'expectations')!;
const whoWeHelp = home.sections[0];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer.join(' ') },
  })),
};
---
<BaseLayout title={home.metaTitle} description={home.description} schema={[faqSchema]}>
  <!-- 1–2. Hero with Ask Astro -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Energy &amp; infrastructure for existing buildings</p>
        <h1 id="hero-title">Better-performing buildings. <span class="h1-accent">A clearer path forward.</span></h1>
        <p class="lede">{home.lede}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact/">Discuss your building <Icon name="arrow" /></a>
          <a class="btn btn-secondary" href="/solutions/">Explore solutions</a>
        </div>
        <div class="hero-ask">
          <AskForm id="home-q" variant="hero" />
          <div class="suggest">
            <p class="suggest-label" id="suggest-label">Try asking</p>
            <ul aria-labelledby="suggest-label">
              {askSuggestions.slice(0, 4).map((q) => (
                <li><a href={`/search/?q=${encodeURIComponent(q)}`}>{q}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="hero-media">
        <div class="photo hero-photo">
          <Picture
            src={heroPhoto}
            alt="Mechanical room with insulated hot-water piping, valves and circulation pumps"
            widths={[520, 800, 1100, 1500]}
            sizes="(min-width: 64rem) 44vw, 100vw"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="hero-card" aria-hidden="true">
          <span class="hc-label">One coordinated path</span>
          <span class="hc-steps">Assess <i>→</i> Prioritize <i>→</i> Plan <i>→</i> Implement <i>→</i> Verify</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Who we help -->
  <section class="who section-surface" aria-labelledby="who-title" id="who-we-help">
    <div class="wrap who-inner">
      <h2 id="who-title" class="who-title">{whoWeHelp.heading}</h2>
      <p class="who-text">{whoWeHelp.body?.[0]}</p>
      <ul class="who-links">
        {industrySummaries.map((i) => <li><a href={i.href ?? `/industries/#${i.anchor}`}>{i.name}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- 4. Goals -->
  <section class="section" aria-labelledby="goals-title">
    <div class="wrap split">
      <div class="goals-head">
        <p class="eyebrow">Start with your goal</p>
        <h2 id="goals-title">What are you trying to improve?</h2>
        <p class="muted">Pick the closest match. Each one leads to the service that usually comes first, and you can always <a href="/contact/">talk it through with us</a>.</p>
      </div>
      <ul class="goal-list">
        {goals.map((g, i) => (
          <li class="goal">
            <span class="goal-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3><a href={g.href}>{g.title}</a></h3>
              <p>{g.text}</p>
            </div>
            <span class="goal-cta" aria-hidden="true">{g.cta} <Icon name="arrow" size={16} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Solutions overview -->
  <section class="section section-night" aria-labelledby="solutions-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Solutions</p>
        <h2 id="solutions-title">Five services that work on their own, and better together</h2>
        <p>Start with whichever fits where you are. Each one hands off cleanly to the next.</p>
      </div>
      <div class="sol-grid">
        <ul class="sol-list">
          {solutionPages.map((p) => (
            <li>
              <a href={p.url}>
                <span class="sol-name">{p.title}</span>
                <span class="sol-desc">{p.lede}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="photo sol-photo">
          <Picture src={techPhoto} alt="Technician in a hard hat inspecting piping and valves in a pump room" widths={[480, 760, 1000]} sizes="(min-width: 64rem) 34vw, 100vw" formats={['avif', 'webp']} loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Process -->
  <section class="section section-sand" aria-labelledby="process-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How an engagement works</p>
        <h2 id="process-title">Assess → Prioritize → Plan → Implement → Verify</h2>
        <p>You approve each stage before the next begins. <a href="/approach/">See the full approach</a>.</p>
      </div>
      <ProcessSteps />
    </div>
  </section>

  <!-- 7. Industry pathways -->
  <section class="section" aria-labelledby="ind-title">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Industries</p>
        <h2 id="ind-title">Find guidance for your type of facility</h2>
      </div>
      <ul class="ind-grid">
        {industrySummaries.map((i) => (
          <li>
            <a href={i.href ?? `/industries/#${i.anchor}`}>
              <span class="ind-name">{i.name}</span>
              <span class="ind-concern">{i.concerns.slice(0, 2).join(' · ')}</span>
              <Icon name="arrow" size={18} class="ind-arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 8. Monitoring & verification -->
  <section class="section section-surface" aria-labelledby="mv-title-h">
    <div class="wrap split split-even mv">
      <div>
        <p class="eyebrow">Monitoring &amp; verification</p>
        <h2 id="mv-title-h">Know whether improvements are working</h2>
        <p class="muted">Measurement and verification (M&amp;V) compares energy use after a project with the baseline measured before it. Astro’s Eco-1 monitoring and analytics system supports each stage.</p>
        <ul class="check-list">{stages.list?.map((l) => <li>{l}</li>)}</ul>
        <p class="mv-link"><a class="link-arrow" href={monitoring.url}>What Eco-1 monitors <Icon name="arrow" size={16} /></a></p>
      </div>
      <MvDiagram />
    </div>
  </section>

  <!-- 9. Funding -->
  <section class="section" aria-labelledby="funding-title">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Funding &amp; incentives</p>
        <h2 id="funding-title">Help paying for improvements, without overpromising</h2>
        <p class="muted">{funding.lede}</p>
        <a class="btn btn-secondary" href={funding.url}>Funding &amp; incentive support</a>
      </div>
      <div class="stack">
        <ul class="check-list">{fundingWork.list?.slice(0, 4).map((l) => <li>{l}</li>)}</ul>
        <div class="note">
          <h3 class="note-title">{fundingExpect.heading}</h3>
          {fundingExpect.body?.map((b) => <p>{b}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 10. Project evidence intentionally omitted until verified case studies are supplied (see docs). -->

  <!-- 11. FAQs -->
  <section class="section section-sand" aria-labelledby="faq-title" id="faq">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title">Common questions</h2>
        <p class="muted">Have a different question? <a href="/search/">Ask Astro</a> searches everything on this site.</p>
      </div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero { padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 5.5rem); }
  .hero-grid { display: grid; gap: var(--space-l); align-items: center; }
  @media (min-width: 64rem) { .hero-grid { grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: var(--space-xl); } }
  .hero h1 { max-width: 15ch; }
  .h1-accent { color: var(--accent-strong); }
  .hero .lede { margin-top: 1.25rem; }
  .hero .btn-row { margin-top: 1.75rem; }
  .hero-ask { margin-top: 2.25rem; max-width: 40rem; }
  .suggest { margin-top: 1rem; }
  .suggest-label { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 0.5rem; }
  .suggest ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .suggest a {
    display: inline-flex; align-items: center; min-height: 2.5rem;
    padding: 0.4rem 0.85rem; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--line);
    color: var(--ink); text-decoration: none; font-size: 0.9rem; line-height: 1.3;
  }
  .suggest a:hover { border-color: var(--accent); color: var(--accent-strong); }
  .hero-media { position: relative; }
  .hero-photo { aspect-ratio: 4 / 5; max-height: 40rem; }
  @media (max-width: 63.99rem) { .hero-photo { aspect-ratio: 16 / 10; } }
  .hero-photo :global(img) { filter: contrast(1.05); }
  .hero-card {
    position: absolute; left: -1.25rem; bottom: 1.5rem;
    display: grid; gap: 0.3rem;
    max-width: calc(100% - 1rem);
    padding: 1rem 1.25rem; border-radius: var(--radius-lg);
    background: var(--night); color: var(--night-ink); box-shadow: var(--shadow);
  }
  @media (max-width: 63.99rem) { .hero-card { left: 0.75rem; bottom: 0.75rem; } }
  .hc-label { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.09em; text-transform: uppercase; color: var(--night-accent); }
  .hc-steps { font-weight: 600; font-size: 0.95rem; }
  .hc-steps i { font-style: normal; color: var(--night-muted); padding-inline: 0.15rem; }

  .who { padding-block: var(--space-l); }
  .who-inner { display: grid; gap: 0.75rem 2.5rem; }
  @media (min-width: 60rem) { .who-inner { grid-template-columns: 11rem minmax(0, 1fr); } .who-links { grid-column: 2; } }
  .who-title { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 500; letter-spacing: 0.09em; text-transform: uppercase; color: var(--accent); margin: 0.4rem 0 0; }
  .who-text { font-size: var(--step-1); line-height: 1.5; margin: 0; max-width: 52rem; }
  .who-links { list-style: none; margin: 0.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; }
  .who-links a { display: inline-flex; min-height: 2.5rem; align-items: center; font-weight: 580; }

  .goal-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .goal {
    position: relative;
    display: grid; grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.25rem 1rem;
    padding: 1.35rem 0.5rem; border-bottom: 1px solid var(--line);
    transition: background-color 0.15s ease;
  }
  .goal:hover { background: var(--surface); }
  .goal-num { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); padding-top: 0.25rem; }
  .goal h3 { margin: 0 0 0.2rem; font-size: 1.2rem; }
  .goal h3 a { color: var(--ink); text-decoration: none; }
  .goal h3 a::after { content: ''; position: absolute; inset: 0; }
  .goal h3 a:focus-visible { box-shadow: none; }
  .goal:has(a:focus-visible) { box-shadow: var(--focus); border-radius: var(--radius); }
  .goal:hover h3 a { color: var(--accent-strong); }
  .goal p { margin: 0; color: var(--ink-2); }
  .goal-cta { grid-column: 2; display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.4rem; font-size: 0.925rem; font-weight: 600; color: var(--accent); }
  @media (min-width: 48rem) {
    .goal { grid-template-columns: 2.5rem minmax(0, 1fr) auto; align-items: center; }
    .goal-cta { grid-column: 3; margin: 0; }
  }

  .sol-grid { display: grid; gap: var(--space-l); align-items: stretch; }
  @media (min-width: 64rem) { .sol-grid { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); } }
  .sol-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #22344d; }
  .sol-list a { display: grid; gap: 0.2rem; padding: 1.1rem 0.25rem; border-bottom: 1px solid #22344d; color: var(--night-ink); text-decoration: none; }
  .sol-list a:hover .sol-name { color: var(--night-accent); text-decoration: underline; }
  .sol-name { font-weight: 640; font-size: 1.2rem; }
  .sol-desc { color: var(--night-muted); font-size: 0.975rem; }
  .sol-photo { min-height: 18rem; }

  .ind-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; grid-template-columns: minmax(0, 1fr); }
  /* Healthcare and education have detail pages, so they lead; the other three share the second row. */
  @media (min-width: 40rem) { .ind-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .ind-grid li:last-child { grid-column: 1 / -1; } }
  @media (min-width: 64rem) {
    .ind-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .ind-grid li { grid-column: span 2; }
    .ind-grid li:nth-child(-n + 2) { grid-column: span 3; }
    .ind-grid li:last-child { grid-column: span 2; }
    .ind-grid li:nth-child(-n + 2) .ind-name { font-size: 1.35rem; }
  }
  .ind-grid a { position: relative; display: grid; gap: 0.35rem; height: 100%; padding: 1.5rem 3rem 1.5rem 1.5rem; background: var(--surface); color: var(--ink); text-decoration: none; }
  .ind-grid a:hover { background: var(--paper); }
  .ind-grid a:hover .ind-name { color: var(--accent-strong); text-decoration: underline; }
  .ind-name { font-weight: 640; font-size: 1.125rem; }
  .ind-concern { color: var(--ink-2); font-size: 0.925rem; }
  .ind-grid :global(.ind-arrow) { position: absolute; right: 1.25rem; top: 1.65rem; color: var(--accent); }

  .mv { align-items: center; }
  .mv-link { margin-top: 1.5rem; }
  .note-title { font-size: 1.05rem; margin-bottom: 0.35rem; }
</style>
