# Copy to .env and fill in. Never commit real values.

# Canonical site URL used for canonical links, sitemap and Open Graph.
SITE_URL=https://www.astroenergygroup.com

# --- Ask Astro AI answers (optional) ---
# Without a key, search still works fully; the AI answer panel reports that it is unavailable.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ASTRO_AI_MODEL=
# Requests per minute allowed per visitor IP for AI answers (default: 8).
ASK_RATE_LIMIT_PER_MIN=8

# --- Contact form delivery (configure ONE) ---
# Option A: Resend (https://resend.com) transactional email
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Option B: POST the inquiry as JSON to a webhook (e.g. a CRM or automation endpoint)
CONTACT_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header
CONTACT_WEBHOOK_SECRET=
